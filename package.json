{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "start:loadtest": "next start -p 9002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "loadtest:100": "node load-tests/run-k6.mjs run -e BASE_URL=http://localhost:9002 -e TARGET_VUS=100 -e HOLD_DURATION=8m load-tests/k6/exam-load.js",
    "loadtest:200": "node load-tests/run-k6.mjs run -e BASE_URL=http://localhost:9002 -e TARGET_VUS=200 -e HOLD_DURATION=8m load-tests/k6/exam-load.js",
    "loadtest:300": "node load-tests/run-k6.mjs run -e BASE_URL=http://localhost:9002 -e TARGET_VUS=300 -e HOLD_DURATION=8m load-tests/k6/exam-load.js",
    "loadtest:500": "node load-tests/run-k6.mjs run -e BASE_URL=http://localhost:9002 -e TARGET_VUS=500 -e RAMP_UP_DURATION=5m -e HOLD_DURATION=12m -e RAMP_DOWN_DURATION=2m -e TEST_MODE=mixed load-tests/k6/exam-load.js",
    "loadtest:500:exam": "node load-tests/run-k6.mjs run -e BASE_URL=http://localhost:9002 -e TARGET_VUS=500 -e RAMP_UP_DURATION=5m -e HOLD_DURATION=12m -e RAMP_DOWN_DURATION=2m -e TEST_MODE=exam load-tests/k6/exam-load.js",
    "loadtest:report": "node load-tests/analyze-k6.mjs"
  },
