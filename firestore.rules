rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
              getUserRole() in ['super_admin', 'isAdmin', 'content_admin', 'exam_admin', 'qa_admin']);
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }
    
    function isExamAdmin() {
      return isAuthenticated() && getUserRole() in ['super_admin', 'isAdmin', 'exam_admin'];
    }
    
    function isContentAdmin() {
      return isAuthenticated() && getUserRole() in ['super_admin', 'isAdmin', 'content_admin'];
    }
    
    function isQAAdmin() {
      return isAuthenticated() && getUserRole() in ['super_admin', 'isAdmin', 'qa_admin'];
    }
    
    function isStudent() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile during signup
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their own profile, but not the role/admin fields
      allow update: if isOwner(userId) && 
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'adminRole', 'isAdmin']));
      
      // Only super admins can update admin roles
      allow update: if isSuperAdmin() && resource.data.adminRole != null;
      
      // Only super admins can delete users
      allow delete: if isSuperAdmin();
    }
    
    // Exams collection - Exam Admin permissions
    match /exams/{examId} {
      // Anyone can read published exams, exam admins can read all
      allow read: if resource.data.isPublished == true || isExamAdmin();
      
      // Only exam admins can create, update, or delete exams
      allow create, update, delete: if isExamAdmin();
    }
    
    // PDFs collection - Content Admin permissions
    match /pdfs/{pdfId} {
      // Anyone can read uploaded PDFs, content admins can read all
      allow read: if resource.data.uploaded == true || isContentAdmin();
      
      // Only content admins can create, update, or delete PDFs
      allow create, update, delete: if isContentAdmin();
    }
    
    // DSA Topics collection - QA Admin permissions
    match /dsa_topics/{topicId} {
      // Anyone can read published topics, QA admins can read all
      allow read: if resource.data.published == true || isQAAdmin();
      
      // Only QA admins can create, update, or delete topics
      allow create, update, delete: if isQAAdmin();
    }
    
    // CS Topics collection - QA Admin permissions
    match /cs_topics/{topicId} {
      // Anyone can read published topics, QA admins can read all
      allow read: if resource.data.published == true || isQAAdmin();
      
      // Only QA admins can create, update, or delete topics
      allow create, update, delete: if isQAAdmin();
    }
    
    // Exam attempts collection
    match /exam_attempts/{attemptId} {
      // Users can read their own attempts, admins can read all
      allow read: if isOwner(resource.data.userId) || isExamAdmin();
      
      // Students can create attempts for themselves
      allow create: if isStudent() && 
                      request.auth.uid == request.resource.data.userId &&
                      request.resource.data.status == 'in_progress';
      
      // Students can update their own in-progress attempts
      allow update: if isOwner(resource.data.userId) && 
                      resource.data.status == 'in_progress';
      
      // Exam admins can update any attempt (for scoring/admin actions)
      allow update: if isExamAdmin();
      
      // Only exam admins can delete attempts
      allow delete: if isExamAdmin();
    }
    
    // Code submissions collection - QA Admin & Owner
    match /code_submissions/{submissionId} {
      // Users can read their own submissions, QA admins can read all
      allow read: if isOwner(resource.data.userId) || isQAAdmin();
      
      // Users can create their own submissions
      allow create: if isAuthenticated() && 
                      request.auth.uid == request.resource.data.userId;
      
      // Users can update their own submissions
      allow update: if isOwner(resource.data.userId);
      
      // Only QA admins can delete submissions
      allow delete: if isQAAdmin();
    }
    
    // Progress tracking collection
    match /progress/{userId} {
      // Users can read their own progress, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can update their own progress
      allow update: if isOwner(userId);
      
      // System can create progress records
      allow create: if isAuthenticated();
      
      // Only super admins can delete progress
      allow delete: if isSuperAdmin();
    }
    
    // Activity tracking collection
    match /activity/{activityId} {
      // Users can read their own activity, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // System can create activity logs
      allow create: if isAuthenticated() && 
                      request.auth.uid == request.resource.data.userId;
      
      // No updates or deletes allowed (audit log)
      allow update, delete: if false;
    }
    
    // Achievements collection
    match /achievements/{achievementId} {
      // Users can read their own achievements, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // System can create achievements
      allow create: if isAuthenticated();
      
      // No updates allowed (achievement records are immutable)
      allow update: if false;
      
      // Only super admins can delete achievements
      allow delete: if isSuperAdmin();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isOwner(resource.data.userId);
      
      // System can create notifications
      allow create: if isAuthenticated();
      
      // Users can mark their own notifications as read
      allow update: if isOwner(resource.data.userId) && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      
      // Users can delete their own notifications
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
