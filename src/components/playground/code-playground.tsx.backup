    id: "reverse-linked-list",
    title: "Reverse Linked List",
    category: "Linked List",
    description: "Given the head of a singly linked list, reverse the list, and return the reversed list.",
    difficulty: "Easy",
    examples: [
      { input: "head = [1,2,3,4,5]", output: "[5,4,3,2,1]", explanation: "" },
      { input: "head = [1,2]", output: "[2,1]", explanation: "" },
      { input: "head = []", output: "[]", explanation: "" }
    ],
    constraints: ["0 ≤ list length ≤ 5000", "-5000 ≤ Node.val ≤ 5000"],
    templates: {
      javascript: `// Reverse Linked List
// Time Complexity: O(n), Space Complexity: O(1)

class ListNode {
  constructor(val = 0, next = null) {
    this.val = val;
    this.next = next;
  }
}

function reverseList(head) {
  let prev = null;
  let current = head;
  
  while (current !== null) {
    const nextTemp = current.next;
    current.next = prev;
    prev = current;
    current = nextTemp;
  }
  
  return prev;
}

// Test helper
function arrayToList(arr) {
  let dummy = new ListNode();
  let current = dummy;
  for (const val of arr) {
    current.next = new ListNode(val);
    current = current.next;
  }
  return dummy.next;
}

function listToArray(head) {
  const result = [];
  while (head) {
    result.push(head.val);
    head = head.next;
  }
  return result;
}

// Test
const list = arrayToList([1,2,3,4,5]);
const reversed = reverseList(list);
console.log(listToArray(reversed)); // [5,4,3,2,1]`,
      python: `# Reverse Linked List
# Time Complexity: O(n), Space Complexity: O(1)

class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next

def reverse_list(head):
    prev = None
    current = head
    
    while current:
        next_temp = current.next
        current.next = prev
        prev = current
        current = next_temp
    
    return prev

# Test helper
def array_to_list(arr):
    dummy = ListNode()
    current = dummy
    for val in arr:
        current.next = ListNode(val)
        current = current.next
    return dummy.next

def list_to_array(head):
    result = []
    while head:
        result.append(head.val)
        head = head.next
    return result

# Test
list_node = array_to_list([1,2,3,4,5])
reversed_list = reverse_list(list_node)
print(list_to_array(reversed_list))  # [5,4,3,2,1]`,
      java: `// Reverse Linked List
// Time Complexity: O(n), Space Complexity: O(1)

class ListNode {
    int val;
    ListNode next;
    ListNode(int val) { this.val = val; }
}

public class Main {
    public static ListNode reverseList(ListNode head) {
        ListNode prev = null;
        ListNode current = head;
        
        while (current != null) {
            ListNode nextTemp = current.next;
            current.next = prev;
            prev = current;
            current = nextTemp;
        }
        
        return prev;
    }
    
    // Test helper
    public static ListNode arrayToList(int[] arr) {
        if (arr.length == 0) return null;
        ListNode dummy = new ListNode(0);
        ListNode current = dummy;
        for (int val : arr) {
            current.next = new ListNode(val);
            current = current.next;
        }
        return dummy.next;
    }
    
    public static String listToArray(ListNode head) {
        StringBuilder result = new StringBuilder("[");
        while (head != null) {
            result.append(head.val);
            if (head.next != null) result.append(",");
            head = head.next;
        }
        result.append("]");
        return result.toString();
    }
    
    public static void main(String[] args) {
        // Test
        ListNode list = arrayToList(new int[]{1,2,3,4,5});
        ListNode reversed = reverseList(list);
        System.out.println(listToArray(reversed)); // [5,4,3,2,1]
    }
}`,
