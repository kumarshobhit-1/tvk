    difficulty: "Easy",
    examples: [
      { input: "prices = [7,1,5,3,6,4]", output: "5", explanation: "Buy on day 2 (price = 1) and sell on day 5 (price = 6), profit = 6-1 = 5" },
      { input: "prices = [7,6,4,3,1]", output: "0", explanation: "No transactions are done and the max profit = 0" }
